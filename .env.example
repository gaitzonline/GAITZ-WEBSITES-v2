# Get a free Postgres database in ~2 minutes: Vercel Postgres (from your # Vercel project → Storage tab) or neon.tech both work. Paste the # connection string it gives you below. DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require" # Generate one with: openssl rand -base64 32 NEXTAUTH_SECRET="replace-with-a-random-32-char-secret" NEXTAUTH_URL="http://localhost:3000" # WhatsApp alert (Twilio) — leave blank to skip sending during local dev. TWILIO_ACCOUNT_SID="" TWILIO_AUTH_TOKEN="" TWILIO_WHATSAPP_FROM="whatsapp:+14155238886" TEAM_WHATSAPP_TO="whatsapp:+910000000000" # Image storage (Vercel Blob) BLOB_READ_WRITE_TOKEN="" # Hidden logo-click shortcut → external admin panel ADMIN_PANEL_URL="https://format-master-37.preview.emergentagent.com/admin
